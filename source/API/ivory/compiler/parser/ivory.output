Terminals unused in grammar

    L_WITH
    L_DO
    L_DEF_EQ
    L_PREFIX_CARET
    L_NUMSIGN_NUMSIGN
    L_NUMSIGN_AT
    PREC_SEL
    L_PLAIN
    PREC_PLAIN_PATTERN
    L_AT_PATTERN
    L_LPAREN_EXCLMARK_RPAREN
    L_PREFIX_NUMSIGN_COLON_COLON


Grammar

    0 $accept: script $end

    1 script: error L_SEMICOLON
    2       | ε
    3       | module
    4       | sequence

    5 module: L_MODULE modId L_WHERE modDeclOrDefnBody

    6 sequence: seqExpr semiSeq sequence
    7         | seqExpr optSemi

    8 modDeclOrDefnBody: modDeclOrDefn
    9                  | L_LCURLYB modDeclOrDefns L_RCURLYB

   10 modDeclOrDefns: modDeclOrDefnList
   11               | ε

   12 modDeclOrDefnList: modDeclOrDefn semiSeq modDeclOrDefnList
   13                  | modDeclOrDefn optSemi

   14 modDeclOrDefn: dynTypeDefn
   15              | objectDefn
   16              | classDefn
   17              | instanceDefn
   18              | L_SUBORDINATE instanceDefn
   19              | dataConDecl
   20              | modifiedDataConDefn
   21              | primDecl
   22              | modifiedDefn

   23 dynTypeDefn: L_DYNAMIC typeDefn
   24            | typeDefn

   25 typeDefn: L_TYPE typeCon typeVars L_EQ dataDecls

   26 objectDefn: L_OBJECT typeCon L_EQ dataDecl

   27 classDefn: L_CLASS genClass L_WHERE classDeclOrDefnBody

   28 genClass: class
   29         | classOrList L_EQ_GT class

   30 classOrList: class
   31            | bracketedClassList

   32 bracketedClassList: bracketedClass bracketedClassListTail

   33 bracketedClassOrList: bracketedClass
   34                     | bracketedClassList

   35 bracketedClassListTail: L_COMMA bracketedClassOrList

   36 bracketedClass: L_LPAREN class L_RPAREN

   37 class: classId typeSigCSList

   38 classDeclOrDefnBody: classDeclOrDefn
   39                    | L_LCURLYB classDeclOrDefnList L_RCURLYB

   40 classDeclOrDefnList: classDeclOrDefn semiSeq classDeclOrDefnList
   41                    | classDeclOrDefn optSemi

   42 classDeclOrDefn: modifiedDefn
   43                | objectDefn
   44                | decl

   45 instanceDefn: L_INSTANCE classId instanceDefnTypes optInstanceDeclOrDefnBody

   46 instanceDefnTypes: typeSigCSList typeQuals

   47 optInstanceDeclOrDefnBody: ε
   48                          | L_WHERE instanceDeclOrDefnBody

   49 instanceDeclOrDefnBody: instanceDeclOrDefn
   50                       | L_LCURLYB instanceDeclOrDefnList L_RCURLYB

   51 instanceDeclOrDefnList: instanceDeclOrDefn semiSeq instanceDeclOrDefnList
   52                       | instanceDeclOrDefn optSemi

   53 instanceDeclOrDefn: decl
   54                   | modifiedDefn
   55                   | dataConDecl
   56                   | modifiedDataConDefn

   57 dataConDecl: dataCon typeConstraint

   58 modifiedDataConDefn: L_INLINE dataConDefn
   59                    | dataConDefn

   60 dataConDefn: dataCon patterns L_EQ expr selectors

   61 selectors: ε
   62          | L_MATCHING selectorBody

   63 selectorBody: L_LCURLYB selectorList L_RCURLYB

   64 selectorList: selector semiSeq selectorList
   65             | selector optSemi

   66 selector: expr
   67         | L_INLINE expr

   68 declOrDefnBody: declOrDefn
   69               | L_LCURLYB declOrDefnList L_RCURLYB

   70 declOrDefnList: declOrDefn semiSeq declOrDefnList
   71               | declOrDefn optSemi

   72 declOrDefn: decl
   73           | modifiedDefn

   74 primDecl: L_PRIMITIVE decl
   75         | decl

   76 decl: signedId

   77 modifiedDefn: L_INLINE defn
   78             | defn

   79 defn: signedId L_EQ expr
   80     | idOrPrefixOp patternList L_EQ expr
   81     | bracketedSignedId patterns L_EQ expr

   82 defCmdBody: defCmd
   83           | L_CMD_LCURLYB defCmdList L_RCURLYB

   84 defCmdList: defCmd semiSeq defCmdList
   85           | defCmd optSemi

   86 defCmd: selExpr L_EQ expr

   87 undefCmdBody: undefCmd
   88             | L_CMD_LCURLYB undefCmdList L_RCURLYB

   89 undefCmdList: undefCmd semiSeq undefCmdList
   90             | undefCmd optSemi

   91 undefCmd: selExpr

   92 patterns: ε
   93         | patternList

   94 patternList: aPattern
   95            | aPattern patternList

   96 pattern: binPattern
   97        | plainPattern
   98        | tuplePattern
   99        | tuplePtrDeconPattern
  100        | ptrPattern
  101        | dataConPtrDeconPattern
  102        | dataConPattern
  103        | concretePattern
  104        | constrainedPattern
  105        | aPattern

  106 binPattern: idName L_COLON pattern
  107           | pattern L_COLON_PLUS pattern

  108 plainPattern: L_TILDE tuplePattern
  109             | L_TILDE_AT tuplePattern
  110             | L_TILDE ptrPattern
  111             | L_TILDE_AT dataCon pattern
  112             | L_TILDE_TILDE dataCon pattern

  113 tuplePtrDeconPattern: L_AT tuplePattern

  114 tuplePattern: L_LPAREN patternComps L_RPAREN

  115 patternComps: patternComps L_COMMA pattern
  116             | pattern L_COMMA pattern

  117 ptrPattern: ptr pattern

  118 dataConPtrDeconPattern: L_AT dataCon pattern

  119 dataConPattern: dataCon patternList

  120 concretePattern: L_TILDE dataCon pattern

  121 constrainedPattern: aPattern typeConstraint

  122 varPattern: idName
  123           | wildcard

  124 aPattern: atom
  125         | dataCon
  126         | L_TILDE dataCon
  127         | varPattern
  128         | L_LSQB L_RSQB
  129         | L_LPAREN pattern L_RPAREN

  130 typeConstraint: L_COLON_COLON typeSig

  131 binTypeSig: typeSig L_COLON typeSig
  132           | typeSig L_TYPESIG_HYPHEN_GT typeSig

  133 monTypeSig: L_TYPESIG_HYPHEN_GT typeSig

  134 apTypeSig: aTypeSig aTypeSig
  135          | apTypeSig aTypeSig

  136 typeSig: apTypeSig
  137        | monTypeSig
  138        | binTypeSig
  139        | aTypeSig

  140 aTypeSig: typeCon
  141         | typeVar
  142         | tag
  143         | L_LPAREN typeSigCompList L_RPAREN
  144         | L_LSQB typeSig L_RSQB
  145         | L_LPAREN typeSig L_RPAREN

  146 typeSigCompList: typeSigCompList L_COMMA typeSig
  147                | typeSig L_COMMA typeSig

  148 typeSigCSList: typeSig
  149              | typeSig L_COMMA typeSigCSList

  150 typeQuals: ε
  151          | L_VERTBAR typeQualOrList

  152 typeQualOrList: typeQual
  153               | bTypeQualList

  154 bTypeQualList: bTypeQual bTypeQualListTail

  155 bTypeQualOrList: bTypeQual
  156                | bTypeQualList

  157 bTypeQualListTail: L_COMMA bTypeQualOrList

  158 typeQual: bTypeQual
  159         | instanceTypeQual

  160 dyadicTypeQual: typeSig predRelOp typeSig
  161               | bTypeQual predAndOp bTypeQual
  162               | bTypeQual predOrOp bTypeQual

  163 monadicTypeQual: L_EXCLMARK typeVar
  164                | predNotOp bTypeQual

  165 instanceTypeQual: L_INSTANCE classId typeSigCSList

  166 bTypeQual: dyadicTypeQual
  167          | monadicTypeQual
  168          | aTypeQual

  169 aTypeQual: L_LPAREN typeQual L_RPAREN

  170 predRelOp: L_EQ
  171          | L_NOTSIGN_EQ

  172 predAndOp: predAndAlts

  173 predAndAlts: L_AND
  174            | L_AMPERSAND

  175 predOrOp: predOrAlts

  176 predOrAlts: L_OR
  177           | L_VERTBAR

  178 predNotOp: predNotAlts

  179 predNotAlts: L_NOT
  180            | L_NOTSIGN

  181 dataDecls: dataDecl L_VERTBAR dataDecls
  182          | dataDecl

  183 dataDecl: dataCon aTypeSigs
  184         | ptr aTypeSigs

  185 aTypeSigs: ε
  186          | aTypeSigList

  187 aTypeSigList: aTypeSig aTypeSigList
  188             | aTypeSig

  189 retExpr: L_RETURN expr
  190        | L_RETURN

  191 defExpr: L_DEF defCmdBody

  192 undefExpr: L_UNDEF undefCmdBody

  193 seqExpr: expr
  194        | retExpr

  195 expr: apExpr
  196     | selExpr
  197     | selDataCon
  198     | monExpr
  199     | binExpr
  200     | genExpr
  201     | bExpr
  202     | expr typeConstraint

  203 genExpr: L_BACKSLASH patterns L_HYPHEN_GT expr
  204        | L_LET declOrDefnBody L_IN expr
  205        | L_IF expr L_THEN expr L_ELSE expr
  206        | L_IF expr L_THEN expr
  207        | defExpr
  208        | undefExpr

  209 apExpr: bExpr bExpr
  210       | apExpr bExpr

  211 binExpr: expr expOp expr
  212        | expr mulDivOp expr
  213        | expr concatOp expr
  214        | expr addSubOp expr
  215        | expr shiftOp expr
  216        | expr bitAndOp expr
  217        | expr bitXorOp expr
  218        | expr bitOrOp expr
  219        | expr relOp expr
  220        | expr logAndOp expr
  221        | expr logOrOp expr
  222        | name L_COLON expr
  223        | expr L_COLON_PLUS expr
  224        | expr L_AT_EQ expr
  225        | selExpr L_COLON_EQ expr

  226 monExpr: L_COLON_COLON aExpr
  227        | attribute expr
  228        | modifier expr
  229        | ptr expr
  230        | L_TILDE ptr expr
  231        | L_HYPHEN expr
  232        | L_PLUS expr
  233        | notOp expr
  234        | bitwiseNotOp expr
  235        | dePtrOp expr

  236 specialExpr: L_NUMSIGN_EXCLMARK aExpr
  237            | L_EXCLMARK aExpr
  238            | L_NOTSIGN_COLON_COLON aExpr
  239            | L_LPAREN_CARET_RPAREN aExpr
  240            | L_NOTSIGN_CARET aExpr

  241 sel: aExpr selOp
  242    | selExpr selOp
  243    | selOp

  244 selExpr: sel idName

  245 selDataCon: sel dataCon

  246 bExpr: aExpr
  247      | specialExpr

  248 aExpr: atom
  249      | idOrPrefixOp
  250      | dataCon
  251      | L_TILDE dataCon
  252      | L_TILDE_TILDE dataCon
  253      | L_LPAREN compList L_RPAREN
  254      | L_TILDE L_LPAREN compList L_RPAREN
  255      | L_LSQB exprs L_RSQB
  256      | L_LSQB expr L_SEMICOLON qualList L_RSQB
  257      | L_LCURLYB sequence L_RCURLYB
  258      | L_CASE expr L_OF L_LCURLYB caseAltList L_RCURLYB
  259      | L_LPAREN expr L_RPAREN
  260      | L_THIS

  261 prefixOp: L_LPAREN dyadicOp L_RPAREN

  262 selOp: L_DOT

  263 expOp: L_CARET

  264 mulDivOp: L_ASTERISK
  265         | L_SLASH
  266         | L_DIV
  267         | L_MOD

  268 concatOp: L_PLUS_PLUS

  269 addSubOp: L_PLUS
  270         | L_HYPHEN

  271 relOp: L_LT
  272      | L_LT_EQ
  273      | L_EQ
  274      | L_NOTSIGN_EQ
  275      | L_GT_EQ
  276      | L_GT

  277 logAndOp: logAndAlts

  278 logAndAlts: L_AND
  279           | L_AMPERSAND

  280 logOrOp: logOrAlts

  281 logOrAlts: L_OR
  282          | L_VERTBAR

  283 shiftOp: L_LT_LT
  284        | L_GT_GT

  285 bitAndOp: L_NUMSIGN_AMPERSAND

  286 bitXorOp: L_NUMSIGN_CARET

  287 bitOrOp: L_NUMSIGN_VERTBAR

  288 assignOp: L_AT_EQ

  289 dyadicOp: selOp
  290         | expOp
  291         | mulDivOp
  292         | concatOp
  293         | addSubOp
  294         | relOp
  295         | logAndOp
  296         | logOrOp
  297         | shiftOp
  298         | bitAndOp
  299         | bitXorOp
  300         | bitOrOp
  301         | assignOp

  302 notOp: notAlts

  303 notAlts: L_NOT
  304        | L_NOTSIGN

  305 bitwiseNotOp: L_NUMSIGN_NOTSIGN

  306 dePtrOp: L_AT

  307 monadicOp: notOp
  308          | bitwiseNotOp
  309          | dePtrOp

  310 exprs: ε
  311      | exprList

  312 exprList: expr L_COMMA exprList
  313         | expr

  314 compList: compList L_COMMA expr
  315         | expr L_COMMA expr

  316 caseAltList: caseAlt semiSeq caseAltList
  317            | caseAlt optSemi

  318 caseAlt: casePatternList L_HYPHEN_GT expr

  319 casePatternList: casePattern L_COMMA casePatternList
  320                | casePattern

  321 casePattern: pattern
  322            | L_OTHERWISE

  323 qual: idName L_LT_HYPHEN expr
  324     | expr

  325 qualList: qual L_COMMA qualList
  326         | qual

  327 typeVars: ε
  328         | typeVarList

  329 typeVarList: typeVar typeVarList
  330            | typeVar

  331 idOrPrefixOp: idName
  332             | prefixOp
  333             | L_LPAREN monadicOp L_RPAREN

  334 bracketedSignedId: L_LPAREN signedId L_RPAREN

  335 signedId: idOrPrefixOp
  336         | idOrPrefixOp typeConstraint

  337 idName: L_LC_NAME

  338 name: L_LC_NAME
  339     | L_UC_NAME

  340 wildcard: L_UNDERSCORE

  341 modifier: L_CONSTANT
  342         | L_VARIABLE
  343         | L_INDISPENSABLE

  344 attribute: L_TRANSIENT
  345          | L_PERSIST
  346          | L_PRIVATE
  347          | L_PUBLIC

  348 modId: name

  349 typeCon: L_UC_NAME
  350        | L_PTR
  351        | L_TYPESIG_ASTERISK

  352 tag: L_TAG

  353 dataCon: L_UC_NAME

  354 ptr: L_PTR
  355    | L_CARET

  356 classId: L_UC_NAME

  357 typeVar: idName

  358 atom: const
  359     | L_NUMSIGN name
  360     | L_NUMSIGN_COLON_COLON aTypeSig
  361     | L_NUMSIGN const

  362 const: L_CHAR
  363      | L_INTEGER
  364      | L_HEX
  365      | L_FIXED
  366      | L_STRING

  367 semiSeq: L_SEMICOLON
  368        | semiSeq L_SEMICOLON

  369 optSemi: ε
  370        | semiSeq


