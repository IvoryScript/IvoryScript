-- PropertySet: A set of key/value properties
-- key :: Name, value :: Any

let ps = PropertySet [x: 10, y: 20] in {
    show ps;      show '\n';
    show (ps.x);  show '\n';
    show (ps.y);  show '\n'
};

let ps = PropertySet [name: "point", coords: (#3, #4)] in {
    show (ps.name);           show '\n';
    show (fst (ps.coords::(Int, Int)));   show '\n';
    show (snd (ps.coords::(Int, Int)));   show '\n'
};