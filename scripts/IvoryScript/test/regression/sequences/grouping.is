show (groupBy (=) [1, 1, 2, 3, 3, 3, 1]);                           show '\n';
show (groupBy (\x y -> x mod 2 = y mod 2) [2, 4, 1, 3, 6, 5]);     show '\n';
show (groupBy (=) (chars "Mississippi"));                            show '\n';
show (span (\n -> n < 5) [1, 3, 5, 7, 2]);                         show '\n';
