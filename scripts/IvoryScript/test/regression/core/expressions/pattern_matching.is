case 42 of { 41 -> "forty-one"; 42 -> "forty-two" };

case 123 of { x -> x };

case ("abc", "def") of { (x, _) -> x };

case (1, 2, (3, 4, 5), 6) of {
   (a::Int, b::Int, (c::Int, d::Int, e::Int), f::Int) -> d + f
};   

case alice:42 of { n:v -> "Name " ++ (stringify n) ++ " = " ++ (stringify (#!v)) };

case ["Apples", "Pears", "Bananas"] of {
   [] ->       "No fruit";
   x :+ xs ->  (stringify x) ++ " followed by " ++ (stringify (xs))
};

case (Just 42) of { Nothing -> 0; Just x -> x };

case ([] :: [Int]) of { [] -> "empty"; _ :+ _ -> "cons" };

-- Explicit lazy product matching: product construction remains strict, while
-- the local binding delays the selection until field demand.

let {
   f :: Int -> Exp (Exp Int, Exp Int);
   f x = (2, let t :: Int = fst (f (x - 1)) in t)
} in
   f 3
