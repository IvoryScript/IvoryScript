module Binding where {

type Binding a b = Bind a b;

Bind :: a -> b -> (a, b);
inline Bind x y = (!x, y)
matching {inline fst; inline snd};

-- Binding instance of Env

instance Env Binding b c where {
   inline needsEnv binding =
      case binding of {
         ~Bind repr -> needsEnv (fst repr) or needsEnv (snd repr)
      };

   inline mapToEnv binding dstEnv =
      case binding of {
         ~Bind repr -> ~Bind (mapToEnv repr dstEnv)
      }
};

-- Binding instance of Mark_GC

instance Mark_GC Binding b c where {
  inline mark_GC binding =
     case binding of {
        lhs:rhs -> { mark_GC lhs; mark_GC rhs }
     };
};

-- Binding instance of Textual

instance Textual Binding b c where {
   inline stringify binding =
      case binding of {
         lhs:rhs ->
            (stringify lhs) ++ 
            ':' ++
            (stringify (::rhs))
     };
};

-- Binding instance of Show

instance Show Binding b c where {
  inline show binding =
     case binding of {
        lhs:rhs -> {
           show lhs;
           show ':';
           show (::rhs)
        }
     };
};

-- InputStream Byte, Binding instance of StreamExtract 

instance StreamExtract InputStream Byte, Binding c d where {
   inline extract is = let {
      lhs :: c = #!(extract is);
      rhs :: d = #!(extract is)
   } in
      ~Bind #!(¬^lhs, ¬^rhs)
};

-- OutputStream Byte Binding instance of StreamInsert 

instance StreamInsert OutputStream Byte, Binding c d where {
  inline insert os binding =
     case binding of {
        lhs:rhs -> {
           insert os lhs;
           insert os rhs
        }
     };
};

-- OutputStream Char Binding instance of StreamInsert 

instance StreamInsert OutputStream Char, Binding c d where {
  inline insert os binding =
     case binding of {
        lhs:rhs -> {
           insert os lhs;
           insert os ':';
           insert os rhs
        }
     };
};

-- BindingSet class

class BindingSet a, b, c where {
   addBinding :: a -> b -> c -> Void;
   hasBinding :: a -> b -> Bool;
   removeBinding :: a -> b -> Void;
};

-- Binding instance of StrictCast

instance StrictCast Binding Name c, Binding Name Any | c ¬= Void, c ¬= Any where {
   inline strictCast b = case b of { n:v -> Bind n (#!(Any (!v))) }

--   inline strictCast b = case b of { n:v -> Bind n  #!(Any ¬::(!v)) }



};

}