module TransientStore where {

type TransientStore = TransientStore;

TransientStore :: TransientDataStore NameAnyMap;
TransientStore = variable (TransientDataStore (NameAnyMap 47));

{-
instance Mark_GC TransientStore where {
   mark_GC ts = case ts of { ~TransientStore repr -> mark_GC repr }
};
-}

instance Mark_GC TransientStore where {
   inline mark_GC ts =
      let tds :: TransientDataStore NameAnyMap = case ts of { ~TransientStore repr -> repr }
      in
         case tds of { ~TransientDataStore repr  ->
            mark_GC #!(fromPlain (fst repr) (snd repr)) 
         }
};

instance Disposable TransientStore where {
  destroy ts = case ts of { ~TransientStore repr -> destroy repr }
};

instance Env TransientStore;

instance BindingSet TransientStore, Name, Any where {
   addBinding ts n v =
      let tds :: TransientDataStore NameAnyMap = case ts of { ~TransientStore repr -> repr }
      in
         case tds of { ~TransientDataStore repr ->
            addBinding (fromPlain (fst repr) (snd repr)) n v;
         };
   hasBinding ts n =
      let tds :: TransientDataStore NameAnyMap = case ts of { ~TransientStore repr -> repr }
      in
         case tds of { ~TransientDataStore repr ->
            hasBinding (fromPlain (fst repr) (snd repr)) n;
         };
   removeBinding ts n =
      let tds :: TransientDataStore NameAnyMap = case ts of { ~TransientStore repr -> repr }
      in
         case tds of { ~TransientDataStore repr ->
            removeBinding (fromPlain (fst repr) (snd repr)) n;
         }
};

instance Select TransientStore, Any where {
   (.) ts name =
      let tds :: TransientDataStore NameAnyMap = case ts of { ~TransientStore repr -> repr }
      in
         case tds of { ~TransientDataStore repr  ->
            (.) (fromPlain (fst repr) (snd repr)) name;
         }
};

instance Show TransientStore where {
   show ts = case ts of { ~TransientStore repr -> show repr }
};

instance StreamInsert (OutputStream Char), TransientStore where {
   insert os ts = case ts of { ~TransientStore repr -> insert os repr }
};

instance StreamExtract (InputStream Byte), TransientStore where {
   extract is = ~TransientStore #!(extract is)
};

instance StreamInsert (OutputStream Byte), TransientStore where {
   insert os ts = case ts of { ~TransientStore repr -> insert os repr }
}

}

