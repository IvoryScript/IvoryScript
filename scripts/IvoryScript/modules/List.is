instance Textual Exp [b] where {
   inline stringify list = let {
      (stringifyItem :: b -> String) x = stringify (::x);
      (stringifySuffix :: Exp [b] -> String) listRHS =
         case ::listRHS of {
             [] -> ']';
             x :+ xs ->
                ',' ++
                (stringifyItem x) ++
                (stringifySuffix xs)
         }
   } in
      case ::list of {
         [] -> "[]";
         x :+ xs ->
            '[' ++
            (stringifyItem x) ++
            (stringifySuffix xs)
      }        
};

instance Show [b] where {
   inline show list = let {
      (showItem :: b -> Void) x = show (::x);
      (showSuffix :: [b] -> Void) listRHS =
         case listRHS of {
             [] ->      show ']';
             x :+ xs -> {
                show ',';
                showItem x;
                showSuffix (#!xs) }
         }
   } in
      case list of {
         [] ->       show "[]";
         x :+ xs ->  {
            show '[';
            showItem x;
            showSuffix (#!xs) }
      }        
};

subordinate instance Show Exp [b] where {
   inline show list = show #!list
};

-- Instances of Seq (primarily lazy)

instance Seq Exp [b] where {
   inline length =   lengthList;
   inline tail =     tl;
   inline take =     takeListNonStrict;
   inline drop =     dropListNonStrict;
   inline (++) =     concatList
};

subordinate instance Seq [b] where {
   inline length =   lengthList;
   inline tail =     tl;
   inline take =     takeList;
   inline drop =     dropList;
   inline (++) =     concatList_
};

instance IndexableSeq Exp [b], b where {
   inline getAt l i = hd (dropListNonStrict i l);
   inline head = hd
};

subordinate instance IndexableSeq [b], b where {
   inline getAt l i = hd (dropList i l);
   inline head = hd
};

instance ReverseableSeq Exp [b] where {
   inline reverse =  reverseList;
};

subordinate instance ReverseableSeq [b] where {
   inline reverse =  reverseList;
};

}      