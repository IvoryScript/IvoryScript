instance Env [b] where {
   inline needsEnv list = True;  
   inline mapToEnv list dstEnv = 
      let env::Env = consEnv  
      in {
         setEnv dstEnv;
         let res :: [b] = 
            case list of {
               [] -> [];
               Cons x xs -> ~Cons #!(Ptr ¬^(#!(¬^(#!(mapToEnv x  dstEnv)),
                                               ¬^(#!(mapToEnv xs dstEnv)))));
            }
         in {
            setEnv env;
            res
         }
      }
};

instance Mark_GC [b] where {
   inline mark_GC list  =
      case list of {
         [] -> Void;
         ~Cons repr -> 
            case repr of {Ptr (x, xs) ->
               if markPtr_GC repr then {
                  mark_GC x;
                  mark_GC xs
               }
            }
      }
};

instance StreamExtract InputStream Byte, [c] where {
   inline extract is =
      if ((#!(extract is)) :: Int) = 0
         then Nil
         else let {
                 x =   (#!(extract is))::c;
                 xs =  (#!(extract is))::Exp [c]
              } in
                 unmappedCons x xs
};

instance StreamInsert OutputStream Byte, [c] where {
inline
   insert os list = case list of {
      [] ->       insert os #0;
      x :+ xs ->  { insert os #1; insert os x; insert os xs }
   }
};

instance StreamInsert OutputStream Char, [c] where {
   inline insert os list = let {
      (insertItem :: OutputStream Char -> c -> Void) os x = insert os (::x);
      (insertSuffix :: OutputStream Char -> [c] -> Void) os listRHS =
         case listRHS of {
             [] ->      insert os ']';
             x :+ xs -> {
                insert os ',';
                insertItem os x;
                insertSuffix os (#!xs) }
         }
   } in
      case list of {
         [] ->       insert os "[]";
         x :+ xs ->  {
            insert os '[';
            insertItem os x;
            insertSuffix os (#!xs) }
      }        
};

subordinate instance StreamInsert OutputStream Char, Exp [c] where {
   inline insert os list = insert os #!list
};

