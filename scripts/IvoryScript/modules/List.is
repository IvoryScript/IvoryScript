module List where {

type List a = Nil | Cons a (Exp [a]);


Nil :: Ptr Void;
inline Nil = #!Null;

Cons :: a -> Exp [a] -> Ptr (a, Exp [a]);
--inline Cons x xs = Ptr ¬^(x, xs)
inline Cons = #!(\x xs -> #!(Ptr ¬^(#!(x, xs))))
matching {inline \repr -> case repr of {Ptr (x, _)  -> x};
          inline \repr -> case repr of {Ptr (_, xs) -> xs}};

unmappedCons :: a -> Exp [a] -> [a];
inline unmappedCons x xs = ~Cons #!(Ptr ¬^(#!(¬^x, ¬^xs)));


-- Head item

hd :: c -> d;
inline hd l =
   #!case ::l of {
      [] ->       #!(error "hd: Empty list");
      x :+ _ ->   x
   };


-- Tail item(s)

tl :: c -> d;
inline tl l =
   #!case ::l of {
      [] -> #!(error "tl: Empty list");
      _ :+ xs -> (::xs)
   };
   
-- Prefix - take

takeList :: Int -> c -> c;
inline takeList n l =
   let {
      takeList_ :: Int -> c -> c;
      takeList_ n l =
         if n <= 0 then [] else
            case ::l of {
               [] ->       [];
               x :+ xs ->  x :+ takeList_ (n - 1) (::xs)
            }
   } in
      takeList_ n l;


takeListNonStrict :: Int -> Exp [c] -> Exp [c];
inline takeListNonStrict n l =
   let {
      takeList_ :: Int -> [c] -> [c];
      takeList_ n l =
         if n <= 0 then [] else
            case l of {
               [] ->       [];
               x :+ xs ->  x :+ takeList_ (n - 1) #!xs
            }
   } in
      takeList_ n #!l;

-- Prefix - take while predicate

takeWhile :: (a -> Bool) -> [a] -> [a];
inline takeWhile p l =
   let {
      takeWhile_ :: (a -> Bool) -> [a] -> [a];
      takeWhile_ p l =
         case l of {
            [] ->       [];
            x :+ xs ->  if p x then x :+ takeWhile_ p (::xs)
                               else [];
         }
   } in
      takeWhile_ p l;


-- Suffix - dropList

dropList :: Int -> c -> c;
inline dropList n l =
   let {
      dropList_ :: Int -> c -> c;
      dropList_ n l =
         if n <= 0 then l else
            case ::l of {
               [] ->       l;
               x :+ xs ->  dropList_ (n - 1) (::xs);
         }
   } in
      dropList_ n l;

dropListNonStrict :: Int -> Exp [c] -> Exp [c];
inline dropListNonStrict n l =
   let {
      dropList_ :: Int -> [c] -> [c];
      dropList_ n l =
         if n <= 0 then l else
            case l of {
               [] ->       l;
               x :+ xs ->  dropList_ (n - 1) #!xs;
         }
   } in
      dropList_ n #!l;

-- Suffix - drop while predicate

dropWhile :: (a -> Bool) -> [a] -> [a];
inline dropWhile p l =
   let {
      dropWhile_ :: (a -> Bool) -> [a] -> [a];
      dropWhile_ p l =
         case l of {
            [] ->       [];
            x :+ xs ->  if p x then dropWhile_ p (::xs)
                               else l;
         }
   } in
      dropWhile_ p l;

-- lengthList

lengthList :: b -> Int;
inline lengthList l =
   let { lengthList_ :: b -> Int -> Int;
         lengthList_ l acc =
            case ::l of {
               [] ->       acc;
               _ :+ xs ->  lengthList_ (::xs) (acc + 1)
            }
   } in
      lengthList_ l 0;

lengthList__ :: [Int] -> Int;
inline lengthList__ l =
   let { lengthList_ :: [Int] -> Int -> Int;
         lengthList_ l acc =
            case l of {
               [] ->       acc;
               _ :+ xs ->  lengthList_ (::xs) (acc + 1)
            }
   } in
      lengthList_ l 0;

lengthListStrict :: [a] -> Int;
inline lengthListStrict l =
   let { lengthListStrict_ :: [a] -> Int -> Int;
         lengthListStrict_ l acc =
            case l of {
               [] ->       acc;
               _ :+ xs ->  lengthListStrict_ (::xs) (acc + 1)
            }
   } in
      lengthListStrict_ l 0;


-- Concatanate two lists

concatList :: Exp [a] -> Exp [a] -> Exp [a];
inline concatList x y =
   #!(let (concatList_ :: Exp [a] -> Exp [a] -> Exp [a]) x y =
      #!(case #!x of { [] ->      y;
                    z :+ zs -> z :+ #!(concatList_ zs y) })
   in
      #!(concatList_ x y));

concatList_ :: [a] -> [a] -> [a];
inline concatList_ x y =
   #!(let (concatList_ :: [a] -> [a] -> [a]) x y =
      #!(case x of { [] ->      y;
                  z :+ zs -> #!(z :+ (concatList_ (#!zs) y)) })
   in
      #!(concatList_ x y));


{-
-- listHasItem: test for one or more occurrences of list item
-- for a given predicate

listHasItem :: (a -> a -> Bool) -> a -> [a] -> Bool;
inline listHasItem pred x zs =
   let {
      hasItem_ :: (a -> a -> Bool) -> a -> [a] -> Bool;
      hasItem_ pred x zs =      
         case zs of {
            []       -> False;
            y :+ ys  -> if pred x y then True
                                    else hasItem_ pred x (#!ys)
         }
   } in
      hasItem_ pred x zs;


-- noDupsInList: test a list for no duplicate items
-- according to a given predicate

noDupsInList :: (a -> a -> Bool) -> [a] -> Bool;
inline noDupsInList pred ys =
   let {
      noDups_ :: (a -> a -> Bool) -> [a] -> Bool;
      noDups_ pred ys =      
         case ys of {
            []       -> True;
            x :+ xs  ->
               let tail = #!xs
               in
                  (¬(listHasItem pred x tail)) & (noDups_ pred tail)
         }
   } in
      noDups_ pred ys;

      
-- uniqueList: return a unique list according to a given predicate
--             for any duplicated items, only the last is included
-- (scripted to avoid reconstructing the list if no duplicates)

uniqueList :: (a -> a -> Bool) -> [a] -> [a];
inline uniqueList pred ys =
   let {
      unique_ :: (a -> a -> Bool) -> [a] -> [a];
      unique_ pred ys =      
         case ys of {
            []       -> [];
            x :+ xs  ->
               let tail :: [a] = #!xs in
                  if listHasItem pred x tail then
                     unique_ pred tail
                  else
                     if noDupsInList pred tail then ys
                        else x :+ (unique_ pred tail)
         }
   } in
      unique_ pred ys;
-}


-- Reverse a list

reverseList :: c -> c;
inline reverseList l =
   #!(let {
      reverse_:: c -> c -> c;
      reverse_ l lRev =
         #!case ::l of {
            [] ->       lRev;
            x :+ xs ->  #!(reverse_ (::xs) (x :+ (::lRev))) }
   } in
      #!(reverse_ l []));

-- Return list of value replicated n times

replicate :: a -> Int -> b;
inline replicate x n =
   let { replicate_ :: a -> Int -> b;
         replicate_ x n = if n = 0 then []
                                   else x :+ (replicate_ x (n - 1))
   } in
      replicate_ x n;


-- Return infinite list of value repeated

repeat :: a -> Exp [a];
inline repeat x =
   let (repeat_ :: a -> Exp [a]) x =  x :+ (repeat_ x)
   in
      repeat_ x;


-- Return list repeated infinitely

cycle :: b -> b;
inline cycle l =
   let (cycle_ :: b -> b) l =
      let ls :: b = l ++ (cycle_ l) in !ls
   in
      cycle_ l;

{-
cycle :: b -> b;
inline cycle l =
   let (cycle_:: b ->b -> b) x y =
      case ::x of { [] ->      cycle_ y y;
                    z :+ zs -> z :+ (cycle_ zs y) }
               
   in
      #!(cycle_ l l);

cycle :: b -> b;
inline cycle l =
   case ::l of {
      [] -> [];
      otherwise -> let ls = l ++ ls in ls
   }
-}

-- Simple numeric sequences

listFrom :: a -> a -> b;
inline
listFrom s step  =
   let (listFrom_ :: a -> a -> [a]) s step =
      s :+ (listFrom_ (s + step) step)
   in
      #!(listFrom_ s step);

listFromX :: a -> a -> Exp [a];
inline
listFromX s step  =
   let (listFrom_ :: a -> a -> [a]) s step =
      s :+ (listFrom_ (s + step) step)
   in
      listFrom_ s step;

listFromTo :: a -> a -> a -> b;
inline
listFromTo s step e =
   let (listFromTo_ :: a -> a -> a -> [a]) s step e =
      if (if step > 0 then s > e else s < e) then []
         else s :+ (listFromTo_ (s + step) step e)
   in
      listFromTo_ s step e;

listFromToX :: a -> a -> a -> Exp [a];
inline
listFromToX s step e =
   let (listFromTo_ :: a -> a -> a -> [a]) s step e =
      if s > e then []
               else s :+ (listFromTo_ (s + step) step e)
   in
      listFromTo_ s step e;

listFromToXX :: a -> a -> a -> [a];
inline
listFromToXX s step e =
   let (listFromTo_ :: a -> a -> a -> [a]) s step e =
      if s > e then []
               else s :+ (listFromTo_ (s + step) step e)
   in
      listFromTo_ s step e;


-- Merge two ordered lists

merge :: b -> b -> b;
inline merge lx ly = 
   #!(let {
      merge_ :: b -> b -> b;
      merge_ lx ly =
         case ::lx of {
            [] -> ly;
            x :+ xs -> case ::ly of {
               [] -> lx;
               y :+ ys -> if x <= y then x :+ (merge_ (::xs) ly)
                                    else y :+ (merge_ lx (::ys))
            }
         }
      }
   in
      merge_ lx ly);

-- Merge sort a list

mergeSort :: [c] -> [c];
inline mergeSort l =
   #!(let {
      mergeSort_ :: [c] -> [c];
      mergeSort_ l =
         let len :: Int = lengthList l
         in
            if len < 2 then l
            else
               let p :: Int = len div 2
               in
                  #!(merge #!(mergeSort_ #!(takeList p l)) #!(mergeSort_ #!(dropList p l)))
   } in
      mergeSort_ l);



{- Polymorphic for [a] and Exp [a]

   T.B.D. Investigate issues with excessive closure formation

mergeSort :: c -> c;
inline mergeSort l =
   #!(let {
      mergeSort_ :: c -> c;
      mergeSort_ l =
         let len :: Int = length (::l)
         in
            if len < 2 then l
            else
               let p :: Int = len div 2
               in
                  #!(merge (mergeSort_ #!(take p l)) (mergeSort_ #!(drop p l)))
   } in
      mergeSort_ l);
-}


