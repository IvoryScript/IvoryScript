showLazyList :: [Exp a] -> Void;
inline showLazyList l =
   let (showSuffix::[Exp a] -> Void) listRHS =
      case listRHS of {
            [] ->       show ']';
            x :+ xs ->  { show ','; show x; showSuffix #!xs }
      } 
   in
      case l of {
         [] ->       show "[]";
         x :+ xs ->  { show '['; show x; showSuffix #!xs }
      };
