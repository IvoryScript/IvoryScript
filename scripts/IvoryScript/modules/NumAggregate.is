module NumAggregate where {

class SumAggregate a, b where {
   sum :: a -> b;
};

class MeanAggregate a, b where {
   mean :: a -> b
};

-- Median of elements in a list 

median :: [a] -> a;
inline median l = 
   let {
      midPair :: [a] -> Int -> (a, a);
      midPair list n = 
         case list of {
            x :+ xs -> if n = 0 then 
                        case ::xs of {
                           y :+ _ -> (x, y)
                        }
                      else midPair (::xs) (n - 1)
         };
      
      nth :: [a] -> Int -> a;
      nth list n = 
         case list of {
            x :+ xs -> if n = 0 then x else nth (::xs) (n - 1)
         };
      
      median_ :: [a] -> a;
      median_ l =
         let {
            len :: Int = length l;
            sorted :: [a] = mergeSort l
         } in
            if len > 0 then {
               if len mod 2 = 0 then 
                  let mp :: (a, a) = midPair sorted (len div 2 - 1)
                  in ((fst mp) + (snd mp)) / 2
               else 
                  nth sorted (len div 2)
            } else
               error "median: empty list"
   } in
      median_ l;



instance SumAggregate [Int], Int where {
   sum l = let {f :: Int -> Int -> Int;
                f x y = x + y} in foldl f 0 l
};

instance MeanAggregate [Int], Double where {
   mean l = let s :: Int = sum l in (::s) / length l
};



instance SumAggregate [Double], Double where {
   sum l = let {f :: Double -> Double -> Double;
                f x y = x + y} in foldl f zero l
};

instance MeanAggregate [Double], Double where {
   mean l = (sum l) / (length l)
}

}