module Tuple_4_10 where {

-- Type: (a, b, c, d)

instance Env (b, c, d, e) where {
   inline needsEnv quadruple =
      case quadruple of {(c1, c2, c3, c4) ->
         #!((#!(needsEnv c1)) or
             (#!(needsEnv c2)) or
             (#!(needsEnv c3)) or
             (#!(needsEnv c4)))};
   inline mapToEnv quadruple env =
      case quadruple of { (c1, c2, c3, c4) ->
         #!(¬^(#!(mapToEnv c1 env)),
             ¬^(#!(mapToEnv c2 env)),
             ¬^(#!(mapToEnv c3 env)),
             ¬^(#!(mapToEnv c4 env)))}
};

instance Mark_GC (b, c, d, e) where {
   inline mark_GC quadruple =
      case quadruple of { (c1, c2, c3, c4) -> {
         mark_GC c1;
         mark_GC c2;
         mark_GC c3;
         mark_GC c4} }
};

instance Eq (b, c, d, e) where {
   inline (=) x y =
      case x of { (x1, x2, x3, x4) ->
         case y of { (y1, y2, y3, y4) ->
            x1 = y1 and
            x2 = y2 and
            x3 = y3 and
            x4 = y4
        }
     }
};

instance Textual (b, c, d, e) where {
  inline stringify quadruple =
     case quadruple of { (c1, c2, c3, c4) ->
        '(' ++ (stringify (::c1)) ++
        ',' ++ (stringify (::c2)) ++
        ',' ++ (stringify (::c3)) ++
        ',' ++ (stringify (::c4)) ++ ')'
     }
};

instance Show (b, c, d, e) where {
   inline show quadruple =
      #!case quadruple of { (c1, c2, c3, c4) -> #!{
         #!(show (#!'(')); #!(show (::c1));
         #!(show (#!',')); #!(show (::c2));
         #!(show (#!',')); #!(show (::c3));
         #!(show (#!',')); #!(show (::c4));
         #!(show (#!')')) }
     }
};

-- Type: (a, b, c, d, e)

