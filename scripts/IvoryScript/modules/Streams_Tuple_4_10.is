module Tuple_4_10 where {

-- Type: (a, b, c, d)

instance StreamExtract (InputStream Byte), (c, d, e, f) where {
   inline extract is = let {
      c1 =  (#!(extract is)) :: c;
      c2 =  (#!(extract is)) :: d;
      c3 =  (#!(extract is)) :: e;
      c4 =  (#!(extract is)) :: f;
   } in
      #!(¬^c1, ¬^c2, ¬^c3, ¬^c4)
};

instance StreamInsert (OutputStream Byte), (c, d, e, f) where {
   inline insert os quadruple =
      #!case quadruple of { (c1, c2, c3, c4) -> #!{
         #!(insert os c1);
         #!(insert os c2);
         #!(insert os c3);
         #!(insert os c4)
     }}
};

-- Type: (a, b, c, d, e)

instance StreamExtract (InputStream Byte), (c, d, e, f, g) where {
   inline extract is = let {
      c1 =  (#!(extract is)) :: c;
      c2 =  (#!(extract is)) :: d;
      c3 =  (#!(extract is)) :: e;
      c4 =  (#!(extract is)) :: f;
      c5 =  (#!(extract is)) :: g
   } in
      #!(¬^c1, ¬^c2, ¬^c3, ¬^c4, ¬^c5)
};

instance StreamInsert (OutputStream Byte), (c, d, e, f, g) where {
   inline insert os quintuple =
      #!case quintuple of { (c1, c2, c3, c4, c5) -> #!{
         #!(insert os c1);
         #!(insert os c2);
         #!(insert os c3);
         #!(insert os c4);
         #!(insert os c5)
     }}
};

-- Type: (a, b, c, d, e, f)

instance StreamExtract (InputStream Byte), (c, d, e, f, g, h) where {
   inline extract is = let {
      c1 =  (#!(extract is)) :: c;
      c2 =  (#!(extract is)) :: d;
      c3 =  (#!(extract is)) :: e;
      c4 =  (#!(extract is)) :: f;
