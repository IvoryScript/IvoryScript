   } in
      #!(¬^c1, ¬^c2, ¬^c3, ¬^c4, ¬^c5, ¬^c6, ¬^c7)
};

instance StreamInsert (OutputStream Byte), (c, d, e, f, g, h, i) where {
   inline insert os septuple =
      #!case septuple of { (c1, c2, c3, c4, c5, c6, c7) -> #!{
         #!(insert os c1);
         #!(insert os c2);
         #!(insert os c3);
         #!(insert os c4);
