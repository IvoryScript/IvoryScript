      c6 =  (#!(extract is)) :: h
   } in
      #!(¬^c1, ¬^c2, ¬^c3, ¬^c4, ¬^c5, ¬^c6)
};

instance StreamInsert (OutputStream Byte), (c, d, e, f, g, h) where {
   inline insert os sextuple =
      #!case sextuple of { (c1, c2, c3, c4, c5, c6) -> #!{
         #!(insert os c1);
         #!(insert os c2);
         #!(insert os c3);
         #!(insert os c4);
         #!(insert os c5);
         #!(insert os c6);
     }}
};

-- Type: (a, b, c, d, e, f, g)

instance StreamExtract (InputStream Byte), (c, d, e, f, g, h, i) where {
   inline extract is = let {
      c1 =  (#!(extract is)) :: c;
      c2 =  (#!(extract is)) :: d;
