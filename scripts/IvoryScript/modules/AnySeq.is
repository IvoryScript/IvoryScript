module AnySeq where {

-- instance of Seq, note that result :: *

instance Seq * where {
   (++) anyX anyY	=
      case anyX of {
         Any (x :: String) ->
            case anyY of {
               Any (y :: String) -> Any #!(x ++ y)
            };
         Any (x :: [Char]) ->
            case anyY of {
               Any (y :: [Char]) -> Any #!(x ++ y)
            }

      }
};

}