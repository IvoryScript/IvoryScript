module NameAnyMapFunction where {

-- Fold a function over all entries

foldNameAnyMap :: (Name -> Any -> a -> a) ->
                  a ->
                  NameAnyMap -> a;
inline foldNameAnyMap f z map =
   #!(case map of { ~NameAnyMap ht ->
      foldHashTable f z ht
   });

nameAnyMapNames :: NameAnyMap -> Type -> String;
nameAnyMapNames map t =   
   let {
      f :: Name -> Any -> String -> String;
      f name any acc =
         if (typeOfAny any) = t then {
            let s :: String = '"' ++ (nameString name) ++ '"'
            in
               if (length acc) = 0 then
                  s
               else
                  acc ++ ", " ++ s
          } else
             acc
   } in
      '[' ++ (foldNameAnyMap f "" map) ++ ']'

}
