module Arith where {

-- Factorial (tail recursive)

fact :: Int -> Int;
fact n =
   let {
      fact_::Int -> Int -> Int;
      fact_ n acc =
      if n ¬= 0 then fact_ (n - 1) (acc * n)
                else acc
   } in
      fact_ n 1;

-- Greatest common divisor

gcd :: Int -> Int -> Int;
gcd x y =
  if y = 0 then x else
  if x = 0 then y else
  if x < y then gcd x (y mod x) else
                gcd y (x mod y); 

-- Least common multiple

lcm :: Int -> Int -> Int;
lcm x y = x * y div (gcd x y);

-- Fibonacci number

fibonacci :: Int -> Int;
fibonacci n =
   let {
      f :: Int -> Int -> Int -> Int;
      f a b c = if c < 1 then a else f (a + b) a (c - 1)
   } in
	f 0 1 n;

}
