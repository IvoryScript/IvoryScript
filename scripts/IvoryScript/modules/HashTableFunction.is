module HashTableFunction where {

foldHashTable :: (keyType -> valType -> a -> a) ->
                 a ->
                 HashTable keyType valType -> a;

inline foldHashTable f z ht =
   #!(case ht of { ~HashTable repr ->
      let {
         nSlots :: Int = fst repr;
         slots  :: Ptr (Array (Ptr (HashTableEntry keyType valType))) = snd repr;

         foldChain :: (keyType -> valType -> a -> a) ->
                      a ->
                      Ptr (HashTableEntry keyType valType) -> a;   
         foldChain f z nodePtr =
            case nodePtr of {
               Ptr (HashTableEntry next k v) ->
                  foldChain f (f k v z) next;
               Null -> z
            };

         foldFrom :: (keyType -> valType -> a -> a) ->
                     a ->
                     Ptr (Array (Ptr (HashTableEntry keyType valType))) ->
                     Int ->
                     Int -> a;
         foldFrom f z slots nSlots i =
            if i < nSlots then                
               #!(foldFrom f (#!(foldChain f z (getAtPtrArray slots i))) slots nSlots (i + 1) )
            else
               z
      } in
         #!(foldFrom f z slots nSlots 0)
   })

}