module SimpleRoot where {

root :: NameAnyMap;
root =   
   let env::Env = consEnv  
   in {
      setEnv (mkEnv 1024 47 16 47 16 47 47 16);
      let rootStore = #!(NameAnyMap 47) in {
         setEnv env;
         rootStore
      }
   };

{-
