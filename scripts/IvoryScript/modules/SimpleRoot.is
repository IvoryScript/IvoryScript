root :: TransientObjectStore;
root = TransientObjectStore 1024 43 32 43 32 256 256

root :: ADS;
let { rootTDS = TransientDataStore 512 47 47 16 512 47;
      env::Env = consEnv}
in {
   setEnvTDS rootTDS; 
   let ads::ADS = ADS [registerSlots:  47
                       ruleList:	      !RefList[]] rootTDS]
