module NameAnyMap where {

type NameAnyMap = NameAnyMap Int;
NameAnyMap :: Int -> HashTable Name Any;
NameAnyMap nSlots = HashTable nSlots;

-- NameAnyMap instance of Mark_GC

-- T.B.D. investigate code generation falure
-- if 'Mark_GC' instance appears after 'Env' instance

instance Mark_GC NameAnyMap where {
   mark_GC map =
      case map of { ~NameAnyMap ht -> mark_GC ht }
};

-- NameAnyMap instance of Env

instance Env NameAnyMap where {
   inline needsEnv map = True;  
   mapToEnv map env =
      case map of { ~NameAnyMap ht -> ~NameAnyMap #!(mapToEnv ht env) }
};

-- NameAnyMap instance of BindingSet

instance BindingSet NameAnyMap, Name, Any where {
   addBinding map n v =
      case map of { ~NameAnyMap ht -> hashTableAdd ht (hashName n) n v};
   hasBinding map n =
      case map of { ~NameAnyMap ht -> hashTableHas ht (hashName n) n};
   removeBinding map n =
      case map of { ~NameAnyMap ht -> hashTableRemove ht (hashName n) n};
};

-- NameAnyMap instance of Show

instance Show NameAnyMap where {
   show map = case map of { ~NameAnyMap ht -> show ht}
};

-- OutputStream Char, NameAnyMap instance of StreamInsert 

instance StreamInsert OutputStream Char, NameAnyMap where {
   insert os map = case map of { ~NameAnyMap ht -> insert os ht }
};

-- NameAnyMap instance of Select

instance Select NameAnyMap, Any where {
   (.) map name =
      case map of { ~NameAnyMap ht ->
         case hashTableGet ht (hashName name) name of {
            Just x ->  x;
            Nothing -> error "Select: name absent"
         }
      }
};

-- InputStream Byte, NameAnyMap instance of StreamExtract 

instance StreamExtract InputStream Byte, NameAnyMap where {
   extract is = ~NameAnyMap #!(extract is)
};

-- OutputStream Byte, NameAnyMap instance of StreamInsert 

instance StreamInsert OutputStream Byte, NameAnyMap where {
   insert os map = case map of { ~NameAnyMap ht -> insert os ht }
};

}
