module AnyBindingSet where {


instance BindingSet Any, Name, Any where {
   addBinding any n v =
      case any of {
         Any (nam::NameAnyMap) ->      addBinding nam n v;
         Any (ts::TransientStore) ->   addBinding ts n v
      };

   hasBinding any n =
      case any of {
         Any (nam::NameAnyMap) ->      hasBinding nam n;
         Any (ts::TransientStore) ->   hasBinding ts n
      };

   removeBinding any n =
      case any of {
         Any (nam::NameAnyMap) ->      removeBinding nam n;
         Any (ts::TransientStore) ->   removeBinding ts n;
      }
};

subordinate instance Select Any, Any where {
   (.) any name =
      case any of {
         Any (ps::PropertySet) ->      (.) ps name;
         Any (nam::NameAnyMap) ->      (.) nam name;
         Any (ts::TransientStore) ->   (.) ts name
      };
};

}