inline span p l =
   #!(let { 
      span_ ::  (a -> Bool) -> b -> (b, b);
      span_ p l =
         case ::l of {
            [] -> ([]::b, []::b);
            x :+ xs -> if (p x) then
                          let t :: (b, b) = span_ p xs
                          in
                            (x :+ (fst t), snd t)
                       else
                          ([]::b, l)
         }
   } in
      span_ p l);
-}
-- groupBy: list of lists grouped by common predicate

-- e.g. groupBy (=) [1,1,2,3,3,4] -> [[1,1], [2], [3,3], [4]]
-- let { f :: Int -> Int -> Bool; f x y = x = y } in groupBy f [1,1,2,3,3,4]
-- let { f :: Char -> Char -> Bool; f x y = x = y } in groupBy f (chars "Missippi")
{-
groupBy :: (a -> a -> Bool) -> b -> c;
inline groupBy eq l =
   #!(let { 
      groupBy_ ::  (a -> a -> Bool) -> b -> c;
      groupBy_ eq l =
         #!(case ::l of {
            [] -> []::c;
            x :+ xs -> 
               #!(let t :: (b, b) = span (\(y :: a) -> eq x y) xs            
               in 
                  (x :+ (fst t)) :+ (groupBy_ eq (snd t)))
         })
   } in
      groupBy_ eq l);
-}

groupBy :: (a -> a -> Bool) -> [a] -> [[a]];
inline groupBy eq l =
   let { 
      groupBy_ ::  (a -> a -> Bool) -> [a] -> [[a]];
      groupBy_ eq l =
         case l of {
            [] -> [];
            x :+ xs -> 
               let t :: (b, b) = span (\(y :: a) -> eq x y) (::xs)            
               in 
                  (x :+ (fst t)) :+ (groupBy_ eq (snd t))
         }
   } in
      groupBy_ eq l;
}
