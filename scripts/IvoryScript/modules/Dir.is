module Dir where {

-- types Dir and DirEnt are primitive

dir :: String -> Exp [String];

-- Note: list evaluation is lazy, so the 'Dir' handle will not be closed
-- if the list is not fully consumed.

dir pathName =
   let (contents :: Dir -> Exp [String]) dir =
      let next :: Maybe DirEntry = nextDirEntry dir
      in
         case next of {
            Nothing -> {closeDir dir; #![]};
            Just entry -> (dirEntryName entry) :+ (contents dir)
         }
   in
      let dirOrNothing :: (Maybe Dir) = openDir pathName
      in 
         case dirOrNothing of {
            Nothing -> [];
            Just dir -> contents dir
         };
 
 -- T.B.D. Raise exception unless same environment

instance Env DirEntry;
 
instance Mark_GC DirEntry;

instance Env Dir;
 
instance Mark_GC Dir;

instance StreamExtract InputStream Byte, Dir where {
   extract is = #!(error "'extract' invalid for Dir")
};

instance StreamInsert OutputStream Byte, Dir where {
   insert os dir = error "'insert' invalid for Dir"
};

instance StreamExtract InputStream Byte, DirEntry where {
   extract is = #!(error "'extract' invalid for DirEntry")
};

instance StreamInsert OutputStream Byte, DirEntry where {
   insert os dirEntry = error "'insert' invalid for DirEntry"
};

}