module AnyNum where {

-- instance of Num, note that result :: *

instance Num * where {

   zero = 0;

   succ any =
      case any of {
         Any (x :: Int) -> Any #!(x + 1);
         Any (x :: Double) -> Any #!(x + 1.0)
      };

   pred any =
      case any of {
         Any (x :: Int) -> Any #!(x - 1);
         Any (x :: Double) -> Any #!(x - 1.0)
      };

   (+) anyX anyY	=
      case anyX of {
         Any (x :: Int) ->
            case anyY of {
               Any (y :: Int) -> Any #!(x + y);
               Any (y :: Double) -> Any #!((::x) + y); 
            };
         Any (x :: Double) ->
            case anyY of {
               Any (y :: Int) -> Any #!(x + (::y));
               Any (y :: Double) -> Any #!(x + y); 
            }
      };

   (-) anyX anyY	=
      case anyX of {
         Any (x :: Int) ->
            case anyY of {
               Any (y :: Int) -> Any #!(x - y);
               Any (y :: Double) -> Any #!((::x) - y); 
            };
         Any (x :: Double) ->
            case anyY of {
               Any (y :: Int) -> Any #!(x - (::y));
               Any (y :: Double) -> Any #!(x - y); 
            }
      };

   (*) anyX anyY	=
      case anyX of {
         Any (x :: Int) ->
            case anyY of {
               Any (y :: Int) -> Any #!(x * y);
               Any (y :: Double) -> Any #!((::x) * y); 
            };
         Any (x :: Double) ->
            case anyY of {
               Any (y :: Int) -> Any #!(x * (::y));
               Any (y :: Double) -> Any #!(x * y); 
            }
      };

   (mod) anyX anyY	=
      case anyX of {
         Any (x :: Int) ->
            case anyY of {
               Any (y :: Int) -> Any #!(x mod y);
               Any (y :: Double) -> error "AnyNum.mod: Double operand"; 
            };
         Any (x :: Double) -> error "AnyNum.mod: Double operand"
      };

   plus any =
      case any of {
         Any (x :: Int) ->    Any x;
         Any (x :: Double) -> Any x
      };

   negate any =
      case any of {
         Any (x :: Int) ->    Any #!(-x);
         Any (x :: Double) -> Any #!(-x)
      };
      
   abs any =
      case any of {
         Any (x :: Int) ->    Any #!(abs x);
         Any (x :: Double) -> Any #!(abs x);
      }

};

instance FractionalNum * where {
   (/) anyX anyY	=
      case anyX of {
         Any (x :: Int) ->
            case anyY of {
               Any (y :: Int) ->    Any #!((x::Double) / (y :: Double));
               Any (y :: Double) -> Any #!((::x) / y); 
            };
         Any (x :: Double) ->
            case anyY of {
               Any (y :: Int) ->    Any #!(x / (::y));
               Any (y :: Double) -> Any #!(x / y); 
            }
      }
};

}
