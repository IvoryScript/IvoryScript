module StringList where {

-- String as a list of character(s)

chars :: String -> [Char];
chars s =
   let {
      charsFrom :: String -> Int -> Int -> [Char];
      charsFrom s n i =
         if i < n then (getAt s i) :+ (charsFrom s n (i + 1))
                  else []
   } in
      charsFrom s (length s) 0;

-- Quoted list of character(s)

quotedChars :: [Char] -> [String];
quotedChars chars = mapf (\c -> "\'" ++ (::c) ++ "\'") chars;

--quotedChars chars = mapf (\c -> (::c)) chars;

-- List of character(s) as String

string :: [Char] -> String;
string chars =
   let {
      s :: String = mutableString (length chars);
      put :: [Char] -> String -> Int -> String;
      put chars s i =
         case chars of {
            [] -> s;
            c :+ xs -> { putAt s i c; put #!xs s (i + 1) }
         }
   } in
      put chars s 0;
   
   
{- Now built-in
instance ReverseableSeq String where {
   reverse s = string ((reverse (chars s)))
};
-}


instance StrictCast [Char], String where {
   inline strictCast chars = string (let s :: [Char] = chars in s)
};


subordinate instance StrictCast String, Exp [Char] where {
   inline strictCast s = chars s
}
  
}