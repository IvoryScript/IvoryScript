module Property where {

type Property = Property Name a;

Property :: Name -> a -> Binding Name Any;
inline Property name value = ~Bind (name, ¬^(#!(Any ¬::value)))
matching {inline #!(\repr -> #!(case repr of {Bind name _ ->             name}));
          inline #!(\repr -> #!(case repr of {Bind _ (Any (value::a)) -> value}))};

nameOfProperty :: Property -> Name;
inline nameOfProperty p = case p of { ~Property (n:_) -> n};

typeOfProperty :: Property -> Type;
inline typeOfProperty p = case p of { ~Property (Bind _ v) -> typeOfAny v};

-- Property instance of Mark_GC

instance Mark_GC Property where {
  mark_GC p = case p of { ~Property repr -> mark_GC repr };
};

-- Property instance of Env

instance Env Property where {
   inline needsEnv p = True;  
   mapToEnv p dstEnv =
      case p of { ~Property (b :: Binding Name Any) -> ~Property (mapToEnv b dstEnv) }
};

-- Property instance of Show

instance Show Property where {
  show p = case p of { ~Property repr -> show repr };
};

-- InputStream Byte, Property instance of StreamExtract 

instance StreamExtract InputStream Byte, Property where {
   inline extract is = let {
      binding :: Binding Name Any = (extract is);
   } in
      ~Property binding
};

-- OutputStream Byte, Property instance of StreamInsert 

instance StreamInsert OutputStream Byte, Property where {
  inline insert os p = case p of { ~Property repr -> insert os repr };
};

-- Binding values are evaluated when cast to a Property

instance StrictCast Binding Name c, Property where {
   inline strictCast b = case b of { n:v -> Property n ¬::(!v) }
};
{-
instance StrictCast Binding Name (Uneval d), Property where {
   inline strictCast b = case b of { n:(Uneval v) -> Property n (¬::v) }
};
-}

}