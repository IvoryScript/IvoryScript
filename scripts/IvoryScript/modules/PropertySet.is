module PropertySet where {

type PropertySet = PropertySet [Property];

PropertySet :: [Property] -> BasicVector Property; 
PropertySet ps = BasicVector ps
matching {\repr ->
   let {
      n :: Int = length repr;
      propertiesFrom :: Int -> [Property];
      propertiesFrom i =
         if i < n then
            getAtBasicVector_ repr i :+ propertiesFrom (i + 1)
         else
            []
   } in
      propertiesFrom 0
};

properties :: PropertySet -> [Property];
properties ps = case ps of { PropertySet ps -> ps};

-- PropertySet instance of Mark_GC

instance Mark_GC PropertySet where {
   mark_GC ps = case ps of { ~PropertySet repr -> mark_GC repr }
};

-- PropertySet instance of Env

instance Env PropertySet where {
   inline needsEnv ps = True;
   mapToEnv ps env = case ps of { ~PropertySet repr -> ~PropertySet (mapToEnv repr env) }
};

-- PropertySet instance of Select
  
instance Select PropertySet, Any where {
   (.) ps key =
      #!(case ps of { ~PropertySet repr ->
         let {
            n :: Int = length repr;
            searchFrom :: Int -> Int -> (BasicVector Property) -> Name -> Any;
            searchFrom i n repr key =
               if i < n then
                  case getAtBasicVector repr i of {
                     ~Property (name:val)-> if name = key then val
                                          else searchFrom (i + 1) n repr key
                  }
               else
                  #!(error "Property not found")
         } in
            searchFrom 0 n repr key
      })
};

-- PropertySet instance of Show

instance Show PropertySet where {
   show ps = case ps of { ~PropertySet repr -> show repr }
};

-- OutputStream Char, PropertySet instance of StreamInsert 

instance StreamInsert OutputStream Char, PropertySet where {
  inline insert os ps = insert os (properties ps);
};

-- (InputStream Byte), PropertySet instance of StreamExtract 

instance StreamExtract InputStream Byte, PropertySet where {
   inline extract is = let {
      repr :: BasicVector Property = (extract is);
   } in
      ~PropertySet repr
};

-- OutputStream Byte, PropertySet instance of StreamInsert 

instance StreamInsert OutputStream Byte, PropertySet where {
  inline insert os ps = case ps of { ~PropertySet repr -> insert os repr };
};

}
